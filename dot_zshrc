# Functions
function csqs() {
  aws sqs get-queue-url --queue-name $1.fifo --query QueueUrl --output text | xargs -I {} aws sqs purge-queue --queue-url {}
}

function cgv() {
  go env -w GOTOOLCHAIN=go$1
}

function al() {
  aws sso login --profile $1
}

function ap() {
  eval $(aws configure export-credentials --format env --profile $1)
  export AWS_PROFILE="$1"
}

function klogs() {
  local input=$1
  local namespace=${input%%/*}
  local pod=${input#*/}
  shift
  kubectl logs -n "$namespace" -f "$pod" "$@"
}

function aero() {
  local profile="${1:-}"
  if [[ -z "$profile" ]]; then
    echo "Usage: aero <home|office>"
    echo "Current config:"
    rg '^\[workspace-to-monitor' ~/.config/aerospace/aerospace.toml -A1 2>/dev/null \
      | rg -q 'built-in' && echo "  → home" || echo "  → office"
    return 0
  fi
  ~/.config/aerospace/generate-config.sh "$profile"
}

