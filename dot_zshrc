# Completions setup

# Tofu: Use bash-style completion
# Note: Bash completions set up with 'complete' may not appear in fzf-tab
# because fzf-tab works with zsh's native completion system.
# They will still work with traditional zsh completion (disable fzf-tab temporarily with Ctrl+T)
if command -v tofu >/dev/null 2>&1; then
	TOFU_BIN=$(command -v tofu)
	complete -o nospace -C "$TOFU_BIN" tofu 2>/dev/null
fi

