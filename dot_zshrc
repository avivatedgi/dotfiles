# ─────────────────────────────────────
# Auto-start tmux (must be at the end)
# ─────────────────────────────────────
# Only auto-start if:
# - tmux is installed
# - not already inside tmux
# - running in an interactive shell
# - terminal is Alacritty
if command -v tmux &> /dev/null && \
   [[ -z "$TMUX" ]] && \
   [[ $- == *i* ]] && \
   [[ "$TERM_PROGRAM" == "Alacritty" || -n "$ALACRITTY_WINDOW_ID" ]]; then
  export ZSH_TMUX_ALWAYS_SELECT_SESSION=true
  $HOME/.tmux_conf/select_tmux_session.sh
fi
