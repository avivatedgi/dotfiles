# Key bindings - Fix HOME/END keys and ensure emacs mode
bindkey -e  # Explicitly set emacs mode (default, but ensures it's set)

# Bind HOME and END keys properly
bindkey '\e[H'    beginning-of-line  # HOME key (xterm)
bindkey '\eOH'    beginning-of-line  # HOME key (vt100)
bindkey '\e[1~'   beginning-of-line  # HOME key (some terminals)
bindkey '\e[F'    end-of-line        # END key (xterm)
bindkey '\eOF'    end-of-line        # END key (vt100)
bindkey '\e[4~'   end-of-line        # END key (some terminals)

# Bind other navigation keys
bindkey '\e[3~'   delete-char        # DELETE key
bindkey '\e[2~'   overwrite-mode     # INSERT key
bindkey '\e[5~'   history-beginning-search-backward  # PAGE UP
bindkey '\e[6~'   history-beginning-search-forward   # PAGE DOWN

